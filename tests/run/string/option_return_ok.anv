// @mode: run
// @expect: success
// @match-begin
// 1
// 0
// @match-end

fn string_present(x: string?) -> int {
    match x {
        _? => 1,
        _ => 0,
    }
}

fn char_present(x: char?) -> int {
    match x {
        _? => 1,
        _ => 0,
    }
}

fn main() {
    println(string_present("abcd".substring(1, 2)));
    println(char_present("xyz".char_at(9)));
}
