// @mode: run
// @expect: success
// @match-begin
// 😀
// nil
// nil
// nil
// @match-end

fn show(c: char?) {
    match c {
        value? => println(value.to_string()),
        nil => println("nil"),
    }
}

fn main() {
    show(char_from_codepoint(128512));
    show(char_from_codepoint(55296));
    show(char_from_codepoint(-1));
    show(char_from_codepoint(1114112));
}
