// @mode: run
// @expect: success

fn main() {
    let nan = float.nan();
    let inf = float.inf();
    let neg_inf = -float.inf();

    assert(nan.is_nan());
    assert(!nan.is_infinite());
    assert(!nan.is_finite());
    assert(!inf.is_nan());
    assert(inf.is_infinite());
    assert(!inf.is_finite());
    assert(!neg_inf.is_nan());
    assert(neg_inf.is_infinite());
    assert(!neg_inf.is_finite());
    assert(!0.0.is_nan());
    assert(!0.0.is_infinite());
    assert(0.0.is_finite());
    assert(!(-0.0).is_nan());
    assert(!(-0.0).is_infinite());
    assert((-0.0).is_finite());
    assert(!1.25.is_nan());
    assert(!1.25.is_infinite());
    assert(1.25.is_finite());

    assert(2.0.min(3.0) == 2.0);
    assert(2.0.max(3.0) == 3.0);
    assert(inf.min(2.0) == 2.0);
    assert(neg_inf.max(2.0) == 2.0);
    assert(nan.min(2.0).is_nan());
    assert(2.0.min(nan).is_nan());
    assert(nan.max(2.0).is_nan());
    assert(2.0.max(nan).is_nan());
    assert(1.0 / 0.0.min(-0.0) == neg_inf);
    assert(1.0 / (-0.0).min(0.0) == neg_inf);
    assert(1.0 / 0.0.max(-0.0) == inf);
    assert(1.0 / (-0.0).max(0.0) == inf);

    assert(2.0.clamp(1.0, 3.0) == 2.0);
    assert((-inf).clamp(-3.0, 3.0) == -3.0);
    assert(inf.clamp(-3.0, 3.0) == 3.0);
    assert(nan.clamp(1.0, 3.0).is_nan());
    assert(nan.clamp(2.0, 1.0).is_nan());
    assert(2.0.clamp(nan, 3.0).is_nan());
    assert(2.0.clamp(1.0, nan).is_nan());
    assert(1.0 / (-0.0).clamp(-0.0, 0.0) == neg_inf);
    assert(1.0 / 0.0.clamp(-0.0, 0.0) == inf);

    assert((-1.0).sqrt().is_nan());
    assert((-1.0).ln().is_nan());
    assert(0.0.ln() == neg_inf);
    assert((-3.0).abs() == 3.0);
}
