// @mode: run
// @expect: success
// @skip: indexed dataref mutable-place projections are future work
// @match: 2

dataref Bag {
    values: [int; 2],
}

fn bump(ref value: int) {
    value += 1;
}

fn main() {
    var bag = Bag { values: [1, 2] };
    bump(bag.values[0]);
    println(bag.values[0]);
}
