// @mode: run
// @expect: success
// @skip: dataref array payload projection is future work
// @match: 1

dataref Item {
    value: int,
}

dataref Pair {
    items: [Item; 2],
}

fn main() {
    let a = Item { value: 1 };
    let b = Item { value: 2 };
    let pair = Pair { items: [a, b] };
    println(pair.items[0].value);
}
