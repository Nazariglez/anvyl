// @mode: run
// @expect: success
// @skip: todo -> dataref_var_param
// @match-begin
// 2
// 1
// @match-end

dataref Pair {
    a: int,
    b: int,
}

fn swap(var x: int, var y: int) {
    let t = x;
    x = y;
    y = t;
}

fn main() {
    var p = Pair { a: 1, b: 2 };
    swap(p.a, p.b);
    println(p.a);
    println(p.b);
}
