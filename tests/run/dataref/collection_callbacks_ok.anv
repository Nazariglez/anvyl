// @mode: run
// @expect: success
// @match-begin
// 1
// 2
// 3
// 2
// 3
// 13
// @match-end

dataref Store {
    values: [int],
    scores: [string: int],
}

fn main() {
    var store = Store {
        values: [1, 2, 3],
        scores: ["a": 1, "b": 2, "c": 3],
    };
    store.values.for_each(|ref value| println(value));
    store.values.retain(|value| value >= 2);
    println(store.values[0]);

    store.scores.remove_where(|key, value| value < 3);
    if let value? = store.scores["c"] {
        println(value);
    }
    if ref value? = store.scores["c"] {
        value += 10;
    }
    println(store.scores["c"] ?? 0);
}
