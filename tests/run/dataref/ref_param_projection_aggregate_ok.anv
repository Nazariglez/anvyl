// @mode: run
// @expect: success
// @match: 2

struct Stats {
    hp: int,
}

dataref Node {
    stats: Stats,
}

fn replace(ref stats: Stats, other: Stats) {
    stats = other;
}

fn main() {
    var node = Node { stats: Stats { hp: 1 } };
    replace(node.stats, Stats { hp: 2 });
    println(node.stats.hp);
}
