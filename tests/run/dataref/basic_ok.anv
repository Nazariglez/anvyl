// @mode: run
// @expect: success
// @match-begin
// 42
// root
// true
// false
// @match-end

dataref Node {
    value: int,
    label: string,
}

fn main() {
    let n = Node { value: 42, label: "root" };
    let alias = n;
    let other = Node { value: 42, label: "root" };
    println(n.value);
    println(n.label);
    println(n == alias);
    println(n == other);
}
