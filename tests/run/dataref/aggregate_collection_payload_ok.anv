// @mode: run
// @expect: success
// @match-begin
// 2
// 5
// @match-end

struct BagPayload {
    xs: [int],
}

dataref Box {
    payload: BagPayload,
}

fn second(payload: BagPayload) -> int {
    payload.xs[1]
}

fn first(payload: BagPayload) -> int {
    payload.xs[0]
}

fn main() {
    var box = Box { payload: BagPayload { xs: [1, 2] } };
    let before = box.payload;
    box.payload = BagPayload { xs: [5] };
    let after = box.payload;
    println(second(before));
    println(first(after));
}
