// @mode: run
// @expect: success
// @match-begin
// 1
// 2
// @match-end

dataref Node {
    value: int,
}

dataref Bag {
    nodes: [Node],
}

fn first_value(nodes: [Node]) -> int {
    let node = nodes[0];
    node.value
}

fn main() {
    let bag = Bag { nodes: [Node { value: 1 }, Node { value: 2 }] };
    let nodes = bag.nodes;
    println(first_value(nodes));
    let second = nodes[1];
    println(second.value);
}
