// @mode: run
// @expect: success
// @match-begin
// 4
// 0
// @match-end

fn main() {
    var counts: [string: int] = ["a": 1];
    match ref counts["a"] {
        value? => {
            value = 4;
        },
        nil => {},
    };
    println(counts["a"] ?? 0);
    match ref counts["b"] {
        value? => {
            value = 9;
        },
        nil => {
            println(0);
        },
    };
}
