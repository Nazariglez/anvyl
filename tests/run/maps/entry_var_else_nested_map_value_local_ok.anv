// @mode: run
// @expect: success
// @match-begin
// 3
// 1
// @match-end

fn main() {
    var groups: [string: [string: int]] = ["a": ["x": 1]];
    var inner? = groups["a"] else return;
    if ref n? = inner["x"] {
        n += 2;
    }
    println(inner["x"] ?? 0);
    if let updated? = groups["a"] {
        println(updated["x"] ?? 0);
    }
}
