// @mode: run
// @expect: success
// @match-begin
// 1
// 5
// @match-end

fn key(ref calls: int) -> string {
    calls += 1;
    "a"
}

fn main() {
    var calls = 0;
    var counts: [string: int] = ["a": 1];
    if ref value? = counts[key(calls)] {
        value = 5;
    }
    println(calls);
    println(counts["a"] ?? 0);
}
