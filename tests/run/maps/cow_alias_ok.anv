// @mode: run
// @expect: success
// @match-begin
// a
// 1
// b
// 2
// a
// 10
// c
// 3
// @match-end

fn main() {
    var a: [string: int] = ["a": 1, "b": 2];
    var b = a;

    a["a"] = 10;
    a.insert("c", 3);
    let _ = a.remove("b");

    for key, value in b {
        println(key);
        println(value);
    }

    for key, value in a {
        println(key);
        println(value);
    }
}
