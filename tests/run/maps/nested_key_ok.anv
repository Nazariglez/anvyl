// @mode: run
// @expect: success
// @match-begin
// 7
// 9
// -1
// 9
// 11
// @match-end

enum Dir {
    Left,
    Right,
}

struct CellKey {
    pos: (int, string),
    dir: Dir,
}

fn print_slot(slot: int?) {
    if let value? = slot {
        println(value);
    } else {
        println(-1);
    }
}

fn main() {
    var cells: [CellKey: int] = [CellKey { pos: (1, "a"), dir: Dir.Left }: 7];
    print_slot(cells[CellKey { pos: (1, "a"), dir: Dir.Left }]);

    cells[CellKey { pos: (1, "a"), dir: Dir.Left }] = 9;
    cells[CellKey { pos: (2, "b"), dir: Dir.Right }] = 11;
    print_slot(cells[CellKey { pos: (1, "a"), dir: Dir.Left }]);
    print_slot(cells[CellKey { pos: (3, "c"), dir: Dir.Left }]);

    for key, value in cells {
        println(value);
    }
}
