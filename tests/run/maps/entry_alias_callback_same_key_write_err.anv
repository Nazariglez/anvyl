// @mode: run
// @expect: error
// @contains: cannot structurally mutate collection during active iteration or slice view

lazy var counts: [string: int] = ["a": 1];

fn overwrite() {
    counts["a"] = 99;
}

fn main() {
    if ref value? = counts["a"] {
        overwrite();
        value += 1;
    }
}
