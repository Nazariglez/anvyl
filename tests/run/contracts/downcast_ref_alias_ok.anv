// @mode: run
// @expect: success
// @match: 2

contract Updatable {
    fn update(ref self);
}

struct Enemy {
    hp: int,
    fn update(ref self) {}
}

fn main() {
    var actor: dyn Updatable = Enemy { hp: 1 };
    if ref enemy = actor as? Enemy {
        enemy.hp = 2;
    }
    if let enemy? = actor as? Enemy {
        println(enemy.hp);
    }
}
