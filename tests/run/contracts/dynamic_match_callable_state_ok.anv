// @mode: run
// @expect: success
// @match-begin
// 1
// 7
// @match-end

contract Callable {
    fn value(self) -> int;
}

struct Callback {
    f: fn() -> int,

    fn value(self) -> int { 0 }
}

fn fixed() -> int { 1 }

fn make(seed: int) -> fn() -> int {
    || seed
}

fn invoke(f: escaping fn() -> int) -> int {
    f()
}

fn run(value: dyn Callable) -> int {
    match value as? {
        Callback(callback) => invoke(callback.f),
        _ => 0,
    }
}

fn main() {
    println(run(Callback { f: fixed }));
    println(run(Callback { f: make(7) }));
}
