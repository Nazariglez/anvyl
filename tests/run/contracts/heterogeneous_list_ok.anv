// @mode: run
// @expect: success
// @match-begin
// 21
// 22
// @match-end

contract Scored {
    fn score(self) -> int;
}

struct First {
    fn score(self) -> int { 21 }
}

struct Second {
    fn score(self) -> int { 22 }
}

fn main() {
    let actors: [dyn Scored] = [First {}, Second {}];
    println(actors[0].score());
    println(actors[1].score());
}
