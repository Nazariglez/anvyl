// @mode: run
// @expect: success
// @match-begin
// 1
// 3
// 1
// 3
// 7
// 0
// 1
// 2
// 3
// 4
// 5
// 6
// 7
// 2
// done
// @match-end

enum Access: flag {
    Read,
    Write,
    Execute,
    Both = Read | Write,
    All = Both | Execute,
}

const READ_BITS: int = Access.Read;
const MASK_BITS: int = Access.Read | Access.Write;
const ALL_BITS: int = Access.all();

fn print_valid(raw: int) {
    if let value = raw as? Access {
        println(value as int);
    }
}

fn main() {
    println(Access.Read as int);
    let implicit: int = Access.Both;
    println(implicit);
    println(READ_BITS);
    println(MASK_BITS);
    println(ALL_BITS);

    print_valid(0);
    print_valid(1);
    print_valid(2);
    print_valid(3);
    print_valid(4);
    print_valid(5);
    print_valid(6);
    print_valid(7);
    print_valid(-1);
    print_valid(8);

    if var value = 1 as? Access {
        value = Access.Write;
        println(value as int);
    }
    println("done");
}
