// @expect: success
// @skip: todo -> std_mem_auto_collect
// @match-begin
// 2
// 0
// ok
// @match-end

import std.mem;

dataref Node {
    next: Node?,
}

fn make_cycle() {
    var a = Node { next: nil };
    var b = Node { next: nil };
    a.next = b;
    b.next = a;
}

fn main() {
    mem.auto_collect(false);
    make_cycle();
    println(mem.managed_count());
    mem.collect_cycles();
    println(mem.managed_count());
    mem.auto_collect(true);
    println("ok");
}
