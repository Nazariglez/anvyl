// @mode: run
// @expect: success
// @skip: todo -> defer_callable
// @match-begin
// b 10
// a 11
// @match-end

fn apply(f: fn(var int) -> void, var x: int) {
    f(x);
}

fn main() {
    var x = 0;
    let add1: fn(var int) -> void = |var n: int| {
        n = n + 1;
        println(f"a {n}");
    };
    let add10: fn(var int) -> void = |var n: int| {
        n = n + 10;
        println(f"b {n}");
    };
    defer apply(add1, x);
    defer apply(add10, x);
}
