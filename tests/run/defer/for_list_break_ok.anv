// @mode: run
// @expect: success
// @skip: todo -> defer_for_break
// @match-begin
// 0
// loop-defer
// 1
// loop-defer
// done
// @match-end

fn main() {
    let values: [int] = [0, 1, 2];
    for value in values {
        defer println("loop-defer");
        println(value);
        if value == 1 { break; }
    }
    println("done");
}
