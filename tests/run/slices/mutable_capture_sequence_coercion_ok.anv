// @mode: run
// @expect: success
// @match-begin
// 11
// 11
// 11
// 11
// @match-end

fn sum(xs: slice[int]) -> int {
    xs[0] + xs[1]
}

fn set_first(ref xs: slice[int]) {
    xs[0] = 9;
}

fn make_list() -> fn() -> int {
    var values: [int] = [1, 2];
    || {
        set_first(values);
        sum(values)
    }
}

fn make_array() -> fn() -> int {
    var values: [int; 2] = [1, 2];
    || {
        set_first(values);
        sum(values)
    }
}

fn main() {
    var local_list: [int] = [1, 2];
    let update_list = || {
        set_first(local_list);
        sum(local_list)
    };
    println(update_list());

    var local_array: [int; 2] = [1, 2];
    let update_array = || {
        set_first(local_array);
        sum(local_array)
    };
    println(update_array());

    let list = make_list();
    println(list());
    let array = make_array();
    println(array());
}
