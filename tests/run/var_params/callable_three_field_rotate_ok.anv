// @match-end

struct Triple { a: int, b: int, c: int }

fn apply(f: fn(var int, var int, var int) -> void, var a: int, var b: int, var c: int) {
    f(a, b, c);
}

fn rotate3(var a: int, var b: int, var c: int) {
    let tmp = a;
    a = b;
    b = c;
    c = tmp;
}

fn main() {
    var triple = Triple { a: 1, b: 2, c: 3 };
    apply(rotate3, triple.a, triple.b, triple.c);
    println(triple.a);
    println(triple.b);
    println(triple.c);
}
