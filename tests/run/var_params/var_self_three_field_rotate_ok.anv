// @match-end

struct Triple {
    a: int,
    b: int,
    c: int,

    fn rotate_fields(var self) {
        rotate(self.a, self.b, self.c);
    }
}

fn rotate(var a: int, var b: int, var c: int) {
    let tmp = a;
    a = b;
    b = c;
    c = tmp;
}

fn main() {
    var triple = Triple { a: 1, b: 2, c: 3 };
    triple.rotate_fields();
    println(triple.a);
    println(triple.b);
    println(triple.c);
}
