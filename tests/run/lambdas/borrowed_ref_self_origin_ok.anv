// @mode: run
// @expect: success
// @match: 1

struct Counter {
    value: int,
}

fn replace(ref counter: Counter) {
    counter = Counter { value: 1 };
}

extend Counter {
    fn touch(ref self) {
        let f = || {
            replace(self);
        };
        f();
    }
}

fn main() {
    var c = Counter { value: 0 };
    c.touch();
    println(c.value);
}
