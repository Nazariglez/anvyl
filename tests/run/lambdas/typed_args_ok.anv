// @mode: run
// @expect: success
// @match-begin
// 6
// 12
// 7
// @match-end

fn inc(x: int) -> int {
    x + 1
}

fn apply(f: fn(int) -> int, x: int) -> int {
    f(x)
}

fn keep(f: escaping fn(int) -> int, x: int) -> int {
    f(x)
}

fn main() {
    let f = inc;
    println(apply(f, 5));
    println(apply(|x: int| x * 2, 6));
    println(keep(|x: int| -> int { x - 3 }, 10));
}
