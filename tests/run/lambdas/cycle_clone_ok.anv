// @mode: run
// @expect: success
// @skip: todo -> lambda_cycle_clone
// @match: ok

dataref Node {
    callback: fn() -> void,
}

fn noop() {}

fn make_cycle() {
    var n = Node { callback: noop };
    let f = || { n.callback(); };
    let g = f;
    let h = g;
    n.callback = h;
}

fn main() {
    var i = 0;
    while i < 1000 {
        make_cycle();
        i = i + 1;
    }
    println("ok");
}
