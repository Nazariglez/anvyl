// @mode: run
// @expect: success
// @skip: todo -> lambda_cycle_list
// @match: ok

dataref Node {
    callbacks: [fn() -> void],
}

fn noop() {}

fn make_cycle() {
    var callbacks: [fn() -> void] = [noop];
    var n = Node { callbacks: callbacks };
    let f = || { n.callbacks[0](); };
    var next_callbacks: [fn() -> void] = [f];
    n.callbacks = next_callbacks;
}

fn main() {
    var i = 0;
    while i < 1000 {
        make_cycle();
        i = i + 1;
    }
    println("ok");
}
