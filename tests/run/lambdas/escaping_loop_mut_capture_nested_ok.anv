// @mode: run
// @expect: success
// @match-begin
// 1
// 11
// @match-end

fn make_callbacks() -> [fn() -> int] {
    var callbacks: [fn() -> int] = [];
    var i = 0;
    while i < 2 {
        var count = i * 10;
        callbacks.push(|| {
            let inner = || {
                count += 1;
                count
            };
            inner()
        });
        i += 1;
    }
    callbacks
}

fn main() {
    let callbacks = make_callbacks();
    let first = callbacks[0];
    let second = callbacks[1];
    println(first());
    println(second());
}
