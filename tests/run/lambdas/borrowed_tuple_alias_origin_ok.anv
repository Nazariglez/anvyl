// @mode: run
// @expect: success
// @skip: ref pattern alias lambda capture is not executable yet
// @match: 1

fn inc(ref value: int) {
    value += 1;
}

fn touch(ref pair: (int, int)) {
    var (x, _) = pair;
    let f = || {
        inc(x);
    };
    f();
}

fn main() {
    var pair = (0, 0);
    touch(pair);
    println(pair.0);
}
