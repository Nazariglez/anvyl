// @mode: run
// @expect: success
// @match-begin
// ping
// ping
// 1
// @match-end

fn ping() {
    println("ping");
}

fn twice(f: fn()) {
    f();
    f();
}

fn main() {
    var count = 0;
    let captured = || {
        count += 1;
    };
    let named: fn() = ping;
    let copy = named;
    twice(copy);
    captured();
    println(count);
}
