// @mode: run
// @expect: success
// @match-begin
// 1
// 2
// 3
// 4
// @match-end

fn make_callbacks() -> [fn() -> int] {
    var callbacks: [fn() -> int] = [];
    var count = 0;
    var i = 0;
    while i < 2 {
        callbacks.push(|| {
            count += 1;
            count
        });
        i += 1;
    }
    callbacks
}

fn main() {
    let callbacks = make_callbacks();
    let first = callbacks[0];
    let second = callbacks[1];
    println(first());
    println(second());
    println(first());
    println(second());
}
