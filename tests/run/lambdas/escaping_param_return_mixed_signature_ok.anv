// @mode: run
// @expect: success
// @match-begin
// 4
// 3
// 1
// @match-end

fn four() -> int {
    4
}

fn make(seed: int) -> fn() -> int {
    || seed
}

fn id(f: escaping fn() -> int) -> fn() -> int {
    f
}

fn use_now() -> int {
    var count = 0;
    let f = || {
        count += 1;
        count
    };
    f()
}

fn main() {
    let f = id(four);
    println(f());
    let h0 = make(3);
    let h = id(h0);
    println(h());
    println(use_now());
}
