// @mode: run
// @expect: success
// @skip: todo -> lambda_cycle_mutating
// @match: ok

dataref Node {
    callback: fn() -> void,
    callbacks: [fn() -> void],
    links: [string: Node?],
    next: Node?,
}

fn noop() {}

fn make_mutating_cycles() {
    var init_callbacks: [fn() -> void] = [noop];
    var a = Node {
        callback: noop,
        callbacks: init_callbacks,
        links: [:],
        next: nil,
    };
    var init_callbacks: [fn() -> void] = [noop];
    var b = Node {
        callback: noop,
        callbacks: init_callbacks,
        links: [:],
        next: nil,
    };
    var init_callbacks: [fn() -> void] = [noop];
    var c = Node {
        callback: noop,
        callbacks: init_callbacks,
        links: [:],
        next: nil,
    };

    a.next = b;
    b.next = c;
    c.next = a;

    a.callback = || { b.callback(); };
    b.callback = || { c.callback(); };
    c.callback = || { a.callback(); };

    var a_alias = a;
    var b_alias = b;
    var c_alias = c;

    a_alias.links["peer"] = b_alias;
    b_alias.links["peer"] = c_alias;
    c_alias.links["peer"] = a_alias;

    a_alias.links["backup"] = c_alias;
    b_alias.links["backup"] = a_alias;
    c_alias.links["backup"] = b_alias;

    var a_callbacks: [fn() -> void] = [];
    a_callbacks.push(|| { b_alias.callback(); });
    a_callbacks.push(|| { c_alias.callback(); });
    a_alias.callbacks = a_callbacks;

    var b_callbacks: [fn() -> void] = [];
    b_callbacks.push(|| { c_alias.callback(); });
    b_callbacks.push(|| { c_alias.callback(); });
    b_alias.callbacks = b_callbacks;

    var c_callbacks: [fn() -> void] = [];
    c_callbacks.push(|| { a_alias.callbacks[0](); });
    c_callbacks.push(|| { a_alias.callback(); });
    c_alias.callbacks = c_callbacks;

    a.callback = a_alias.callbacks[0];
    b.callback = b_alias.callbacks[1];
    c.callback = c_alias.callbacks[0];
}

fn main() {
    var i = 0;
    while i < 1000 {
        make_mutating_cycles();
        i = i + 1;
    }
    println("ok");
}
