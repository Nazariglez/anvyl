// @mode: run
// @expect: success
// @match-begin
// 1
// 7
// @match-end

enum Callback {
    Fixed(fn() -> int),
    Captured(fn() -> int),
}

fn fixed() -> int { 1 }

fn make(seed: int) -> fn() -> int {
    || seed
}

fn invoke(f: escaping fn() -> int) -> int {
    f()
}

fn run(callback: Callback) -> int {
    match callback {
        Callback.Fixed(f) | Callback.Captured(f) => invoke(f),
    }
}

fn main() {
    println(run(Callback.Fixed(fixed)));
    println(run(Callback.Captured(make(7))));
}
