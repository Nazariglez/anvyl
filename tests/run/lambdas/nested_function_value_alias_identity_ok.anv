// @mode: run
// @expect: success
// @match-begin
// 1
// 2
// 3
// @match-end

fn call(f: fn() -> int) -> int {
    f()
}

fn main() {
    var count = 0;
    let next = || {
        count += 1;
        count
    };
    let outer = || {
        let alias = next;
        println(call(alias));
        println(call(next));
    };
    outer();
    println(next());
}
