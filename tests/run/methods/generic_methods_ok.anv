// @match-end

struct Foo {
    fn make<T>(x: T) -> T {
        x
    }

    fn pair<A, B>(self, a: A, b: B) -> B {
        b
    }
}

fn main() {
    let f = Foo {};
    println(Foo.make<int>(42));
    println(Foo.make("hi"));
    println(f.pair<int, string>(1, "ok"));
    println(f.pair("x", 7));
}
