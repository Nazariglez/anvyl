// @mode: run
// @expect: success
// @skip: mutable enum tuple payload aliases are not executable yet
// @match: 2

enum Slot {
    Value(int),
}

fn bump(ref value: int) {
    value += 1;
}

fn main() {
    var slot = Slot.Value(1);
    match ref slot {
        Slot.Value(value) => bump(value),
    }
    match slot {
        Slot.Value(value) => println(value),
    }
}
