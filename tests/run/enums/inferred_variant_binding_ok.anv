// @mode: run
// @expect: success
// @match-begin
// item 3
// none
// @match-end

enum Boxed<T> {
    Some(T),
    None,
}

fn describe(value: Boxed<int>) -> string {
    match value {
        .Some(item) => f"item {item}",
        .None => "none",
    }
}

fn main() {
    println(describe(Boxed.Some(3)));
    println(describe(Boxed.None));
}
