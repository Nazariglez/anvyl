// @mode: run
// @expect: success
// @match-begin
// true
// true
// true
// @match-end

fn has_two(r: Range<int>) -> bool {
    r.contains(2)
}

fn make() -> RangeInclusive<int> {
    4..=6
}

fn main() {
    let r = 0..3;
    let copy = r;
    println(has_two(copy));
    let inclusive = make();
    println(inclusive.contains(6));
    let copy2 = inclusive;
    println(copy2.contains(4));
}
