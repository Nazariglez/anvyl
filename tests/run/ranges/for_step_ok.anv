// @mode: run
// @expect: success
// @match-begin
// 0
// 2
// 4
// 6
// 0
// 2
// 4
// 6
// 6
// 4
// 2
// 0
// 5
// 3
// 1
// @match-end

fn main() {
    for n in iter(0..7).step_by(2) {
        println(n);
    }
    for n in iter(0..=6).step_by(2) {
        println(n);
    }
    for n in iter(0..7).rev().step_by(2) {
        println(n);
    }
    for n in iter(0..=5).rev().step_by(2) {
        println(n);
    }
}
