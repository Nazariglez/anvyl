// @match-end

fn main() {
    for n in 0..7 step 2 {
        println(n);
    }
    for n in 0..=6 step 2 {
        println(n);
    }
    for n in rev 0..7 step 2 {
        println(n);
    }
    for n in rev 0..=5 step 2 {
        println(n);
    }
}
