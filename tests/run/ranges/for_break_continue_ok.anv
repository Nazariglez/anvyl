// @mode: run
// @expect: success
// @match-begin
// 1
// 3
// 5
// @match-end

fn main() {
    for n in 0..5 {
        if n == 0 { continue; }
        if n == 2 { continue; }
        println(n);
        if n == 3 { break; }
    }
    for n in iter(0..6).rev().step_by(2) {
        println(n);
        break;
    }
}
