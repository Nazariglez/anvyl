// @mode: run
// @expect: success
// @match-begin
// 4
// 1
// @match-end

fn mutate(xs: slice[int], ref owner: [int]) {
    owner.push(4);
    let appended = owner[3];
    let first = xs[0];
    println(appended);
    println(first);
}

fn main() {
    var list: [int] = [1, 2, 3];
    mutate(list[0..2], list);
}
