// @mode: run
// @expect: success
// @match-begin
// 1
// 3
// 5
// @match-end

fn main() {
    let r = 0..5;
    for n in r {
        if n == 0 { continue; }
        if n == 2 { continue; }
        println(n);
        if n == 3 { break; }
    }
    let stepped = 0..6;
    for n in rev stepped step 2 {
        println(n);
        break;
    }
}
