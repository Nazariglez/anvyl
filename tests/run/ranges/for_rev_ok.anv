fn main() {
    for n in iter(0..5).rev() {
        println(n);
    }
    for n in iter(0..=5).rev() {
        println(n);
    }
    for n in iter(2..7).rev() {
        println(n);
    }
    for n in iter(3..3).rev() {
        println(100);
    }
    for n in iter(4..3).rev() {
        println(100);
    }
}
