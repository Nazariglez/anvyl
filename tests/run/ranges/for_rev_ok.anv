fn main() {
    for n in rev 0..5 {
        println(n);
    }
    for n in rev 0..=5 {
        println(n);
    }
    for n in rev 2..7 {
        println(n);
    }
    for n in rev 3..3 {
        println(100);
    }
    for n in rev 4..3 {
        println(100);
    }
}
