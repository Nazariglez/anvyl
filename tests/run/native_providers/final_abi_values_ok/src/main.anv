// @mode: run
// @expect: success
// @lint: unused=allow
// @match-begin
// 46
// 9
// hi
// 3
// 1
// 1
// 5
// Q
// z
// ?
// x
// 7
// bad
// enum
// 21
// dynamic enum
// 7
// 9
// 7
// NaN
// inf
// -inf
// -0.0
// @match-end

import pkg:host.host {
    HostError,
    make_host_error,
    HostValue,
    make_host_pair,
    make_host_outcome,
    echo_host_value,
    maybe_add,
    swap_pair,
    counted_pair,
    first_array,
    echo_char,
    host_inf,
    host_neg_inf,
    host_payload_nan,
    host_neg_zero,
    host_accepts_nonfinite,
    host_preserves_float_bits,
    maybe_char,
    first_char_array,
    visible_result,
    visible_enum_result,
    describe_result,
    describe_enum_result,
    unit_result,
    describe_unit_result,
};

contract Labeled {
    fn label(self) -> string;
}

contract Scored {
    fn score(self) -> int;
}

fn main() {
    println(maybe_add(41, 5) ?? 0);
    println(maybe_add(nil, 5) ?? 9);

    let pair = swap_pair((3, "hi"));
    println(pair.0);
    println(pair.1);

    let counted = counted_pair();
    println(counted.0);
    println(counted.1);

    println(first_array([5, 6, 7]));
    println(echo_char('Q').to_string());
    println((maybe_char('z') ?? '?').to_string());
    println((maybe_char(nil) ?? '?').to_string());
    println(first_char_array(['x', 'y', 'z']).to_string());
    println(describe_result(visible_result(true)));
    println(describe_result(visible_result(false)));
    println(describe_enum_result(visible_enum_result(false)));
    println(describe_unit_result(unit_result()));

    let labeled: dyn Labeled = make_host_error();
    println(labeled.label());

    let pair = echo_host_value(make_host_pair());
    println(pair.score());
    println(echo_host_value(make_host_outcome()).score());
    let scored: dyn Scored = pair;
    println(scored.score());

    let nan = host_payload_nan();
    let inf = host_inf();
    let neg_inf = host_neg_inf();
    let neg_zero = host_neg_zero();
    assert(nan.is_nan());
    assert(inf.is_infinite());
    assert(neg_inf.is_infinite());
    assert(host_accepts_nonfinite(nan, inf, neg_inf));
    assert(host_preserves_float_bits(nan, neg_zero));
    println(nan);
    println(inf);
    println(neg_inf);
    println(neg_zero);
}
