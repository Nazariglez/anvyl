// @mode: run
// @expect: success
// @match-begin
// hello
// a: 10 b: 20
// 1
// 2
// 42
// spawned orc
// goblin
// collected
// 1
// 2
// @match-end

import pkg:host.host { retain, fire, close, host_log, host_add, host_name, collect_now, each };

fn main() {
    retain(|| println("hello"));
    fire();
    close();

    let a = 10;
    var b = 20;
    retain(|| println(f"a: {a} b: {b}"));
    fire();
    close();

    var total = 0;
    retain(|| {
        total += 1;
        println(total);
    });
    fire();
    fire();
    close();

    retain(|| println(host_add(20, 22)));
    fire();
    close();

    let name = "orc";
    retain(|| host_log(f"spawned {name}"));
    fire();
    close();

    retain(|| println(host_name()));
    fire();
    close();

    retain(|| {
        collect_now();
        println("collected");
    });
    fire();
    close();

    retain(|| { each(|x: int| { println(x); }); });
    fire();
    close();
}
