// @mode: run
// @expect: success
// @match: 1920

import pkg:host.host {
    make_config,
    config_width,
    make_underscores,
    underscores_width,
    WindowConfig,
    UnderscoreConfig,
};

fn main() {
    let config: WindowConfig = make_config(1280);
    let underscores: UnderscoreConfig = make_underscores(640);
    println(config_width(config) + underscores_width(underscores));
}
