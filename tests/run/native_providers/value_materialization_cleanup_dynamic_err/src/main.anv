import pkg:cleanup { Probe, make_probe, probe_id };

contract Tagged {
    fn id(self) -> int;
}

struct Wrapped {
    probe: Probe,

    fn id(self) -> int {
        probe_id(self.probe)
    }
}

fn main() {
    let probe = make_probe(4);
    let tagged: dyn Tagged = Wrapped { probe: probe };
    let missing: [dyn Tagged] = [];
    let values: [dyn Tagged] = [tagged, missing[0]];
}
