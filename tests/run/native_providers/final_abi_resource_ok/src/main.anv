// @mode: run
// @expect: success
// @match-begin
// 42
// 43
// 43
// 43
// 7
// 5
// 7
// 9
// 11
// 13
// missing
// @match-end

import pkg:host.host { Counter, make_counter, make_owned_counter, maybe_owned_counter, result_owned_counter, counter_value, counter_result_value };

fn main() {
    var counter = make_counter(42);
    println(counter_value(counter));
    counter.bump(1);
    println(counter_value(counter));
    let Counter { value } = counter;
    println(value);
    println(counter_value(counter));
    let constructed = Counter { value: 7 };
    let Counter { value: constructed_value } = constructed;
    println(constructed_value);

    let owned = make_owned_counter(5);
    println(counter_value(owned));
    let duplicated = owned.duplicate(2);
    println(counter_value(duplicated));
    let from_static = Counter.from_static(9);
    println(counter_value(from_static));
    let maybe = maybe_owned_counter(true, 11) ?? Counter { value: 0 };
    println(counter_value(maybe));
    println(counter_result_value(result_owned_counter(true, 13)));
    println(counter_result_value(result_owned_counter(false, 0)));
}
