// @mode: run
// @expect: success
// @match: 26

fn main() {
    let a: int = 10 + 10;
    let b: int = 9 - 4;
    let c: int = a * b / 5;
    let d: int = c % 7;
    let bits: int = (6 & 3) + (4 | 1) + (7 ^ 3) + (1 << 3) + (8 >> 1);
    let floats: float = (1.5 + 2.5) * 2.0 / 4.0 - 1.0;
    assert(bits == 23);
    assert(floats == 1.0);
    println(c + d);
}
