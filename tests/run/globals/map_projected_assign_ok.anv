// @mode: run
// @expect: success
// @match-begin
// init
// 9
// @match-end

fn make_values() -> [string: int] {
    println("init");
    ["a": 4]
}

lazy var values = make_values();

fn main() {
    let key = "a";
    values[key] = 9;
    match values[key] {
        value? => println(value),
        nil => println(0),
    };
}
