// @mode: run
// @expect: success
// @match-begin
// 5
// 7
// 9
// 11
// @match-end

enum Choice {
    Pick,
    Drop,
}

fn make_pair() -> (int, bool) { (5, true) }
fn make_choice() -> Choice { Choice.Pick }
fn make_maybe_number() -> int? { 9 }
fn make_numbers() -> [int] { [10, 11] }

fn choice_value(choice: Choice) -> int {
    match choice {
        Choice.Pick => 7,
        Choice.Drop => 0,
    }
}

lazy let pair = make_pair();
lazy let choice = make_choice();
lazy let maybe_number = make_maybe_number();
lazy let numbers = make_numbers();

fn main() {
    let local_pair = pair;
    let local_choice = choice;
    let local_maybe_number = maybe_number;
    let local_numbers = numbers;

    println(local_pair.0);
    println(choice_value(local_choice));
    println(local_maybe_number ?? 0);
    println(local_numbers[1]);
}
