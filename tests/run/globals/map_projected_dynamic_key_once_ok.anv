// @mode: run
// @expect: success
// @match-begin
// init
// key
// 1
// 8
// @match-end

fn make_values() -> [string: int] {
    println("init");
    ["a": 1]
}

fn key(ref calls: int) -> string {
    calls += 1;
    println("key");
    "a"
}

lazy var values = make_values();

fn main() {
    var calls = 0;
    values[key(calls)] = 8;
    let local = values;
    println(calls);
    match local["a"] {
        value? => println(value),
        nil => println(0),
    };
}
