// @mode: run
// @expect: success
// @match-begin
// 9
// 2
// 3
// @match-end

lazy var values: [int] = [1, 2, 3];

fn rewrite_first() {
    values[0] = 9;
}

fn main() {
    values.retain(|value| {
        if value == 1 {
            rewrite_first();
        }
        true
    });
    for value in values {
        println(value);
    }
}
