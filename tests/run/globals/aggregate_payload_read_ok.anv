// @mode: run
// @expect: success
// @match-begin
// root
// 6
// @match-end

dataref Node {
    value: int,
}

struct Holder {
    name: string,
    node: Node?,
}

lazy let holder: Holder = Holder {
    name: "root",
    node: Node { value: 6 },
};

fn main() {
    let local = holder;
    println(local.name);
    match local.node {
        node? => println(node.value),
        nil => println(0),
    };
}
