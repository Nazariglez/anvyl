// @mode: run
// @expect: success
// @match-begin
// 1
// 2
// @match-end

lazy var values: [int] = [1];
lazy var calls = 0;

fn index() -> int {
    calls += 1;
    0
}

fn bump(ref value: int) {
    value += 1;
}

fn main() {
    bump(values[index()]);
    println(calls);
    println(values[0]);
}
