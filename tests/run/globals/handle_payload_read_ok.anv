// @mode: run
// @expect: success
// @match-begin
// 1
// 2
// @match-end

dataref Node {
    value: int,
}

fn value(node: Node) -> int { node.value }

lazy let nodes: [Node] = [Node { value: 1 }];
lazy let table: [string: Node] = ["root": Node { value: 2 }];

fn main() {
    let local_nodes = nodes;
    let local_table = table;
    println(value(local_nodes[0]));
    match local_table["root"] {
        node? => println(value(node)),
        nil => println(0),
    }
}
