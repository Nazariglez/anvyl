// @mode: run
// @expect: success
// @match-begin
// 0
// 30
// 1
// 20
// 2
// 10
// 0
// 50
// 1
// 30
// 2
// 10
// @match-end

fn main() {
    for i, x in iter([10, 20, 30]).rev() {
        println(i);
        println(x);
    }
    for i, x in iter([10, 20, 30, 40, 50]).rev().step_by(2) {
        println(i);
        println(x);
    }
}
