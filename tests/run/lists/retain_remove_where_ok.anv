// @mode: run
// @expect: success
// @match-begin
// 10
// 2
// 4
// 4
// 5
// 6
// 99
// @match-end

fn main() {
    var xs: [int] = [1, 2, 3, 4];
    var seen = 0;
    xs.retain(|x| {
        seen += x;
        x % 2 == 0
    });
    println(seen);
    for x in xs {
        println(x);
    }

    xs.remove_where(|x| x == 2);
    for x in xs {
        println(x);
    }

    var kept: [int] = [5, 6];
    kept.retain(|x| true);
    for x in kept {
        println(x);
    }

    var removed: [int] = [7, 8];
    removed.remove_where(|x| true);
    println(99);
    for x in removed {
        println(x);
    }
}
