// @mode: run
// @expect: success
// @frontend: new
// @skip: clean std linalg provider import is still backed by the legacy provider path
// @match: 5

import std:linalg { vec2, Vec2 };

fn main() {
    let a = vec2(1.0, 2.0);
    let b = Vec2 { x: 1.0, y: 2.0 };
    let Vec2 { x, y } = b;
    assert(a.x == x);
    assert(a.y == y);
    println(5);
}
