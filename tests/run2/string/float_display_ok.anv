// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 1.0
// -2.0
// 1.25
// 3.0
// 4.0
// 5.0
// whole 6.0
// 7
// Point(x: 8.0)
// @match-end

struct Point { x: float }

fn main() {
    println(1.0);
    println(-2.0);
    println(1.25);
    println(#stringify(3.0));
    println("" + 4.0);
    println(f"{5.0}");
    println(f"whole {6.0}");
    println(f"{7.0:.0}");
    println(#stringify(Point { x: 8.0 }));
}
