// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 4
// 5
// 9
// 16
// 3
// 4
// 8
// 15
// @match-end

extend slice[int] {
    fn first(self) -> int { self[0] }

    fn bump0(var self, amount: int) {
        self[0] += amount;
    }
}

fn first_exact(xs: slice[int]) -> int {
    xs.first()
}

fn bump_param(var xs: slice[int], amount: int) {
    xs.bump0(amount);
}

fn main() {
    var list: [int] = [4, 5, 6];
    println(list.first());
    println(first_exact(list[1..3]));
    list.bump0(5);
    println(list[0]);
    bump_param(list, 7);
    println(list[0]);

    var array = [3, 4, 5];
    println(array.first());
    println(first_exact(array[1..3]));
    array.bump0(5);
    println(array[0]);
    bump_param(array, 7);
    println(array[0]);
}
