// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 2
// 0
// 4
// 0
// @match-end

fn print_slot(slot: int?) {
    if let value? = slot {
        println(value);
    } else {
        println(0);
    }
}

fn main() {
    var counts: [string: int] = ["a": 1];
    counts["a"] = 2;
    counts["b"] = nil;
    counts["c"] = Option.Some(4);
    counts["c"] = nil;

    print_slot(counts["a"]);
    print_slot(counts["b"]);
    counts["b"] = 4;
    print_slot(counts["b"]);
    print_slot(counts["c"]);
}
