// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 10
// 15
// 20
// -1
// 15
// 20
// 30
// @match-end

enum Token {
    Int(int),
    Name(string),
    Pair((int, string)),
}

fn print_slot(slot: int?) {
    if let value? = slot {
        println(value);
    } else {
        println(-1);
    }
}

fn main() {
    var by_token: [Token: int] = [Token.Int(1): 10, Token.Name("x"): 20];
    print_slot(by_token[Token.Int(1)]);

    by_token[Token.Int(1)] = 15;
    by_token[Token.Pair((2, "b"))] = 30;
    print_slot(by_token[Token.Int(1)]);
    print_slot(by_token[Token.Name("x")]);
    print_slot(by_token[Token.Name("missing")]);

    for key, value in by_token {
        println(value);
    }
}
