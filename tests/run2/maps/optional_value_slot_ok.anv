// @mode: run
// @frontend: new
// @expect: success
// @skip: clean Rust nested optional map values are unsupported
// @match-begin
// 1
// 0
// 0
// 1
// @match-end

fn print_nested(slot: Option<int?>) {
    if let inner? = slot {
        if let value? = inner {
            println(value);
        } else {
            println(0);
        }
    } else {
        println(0);
    }
}

fn main() {
    var slots: [string: int?] = ["a": 1];
    print_nested(slots["a"]);
    slots["a"] = Option.Some(nil);
    print_nested(slots["a"]);
    slots["a"] = nil;
    print_nested(slots["a"]);
    slots["b"] = Option.Some(1);
    print_nested(slots["b"]);
}
