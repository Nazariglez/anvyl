// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 0
// 7
// @match-end

fn clear(var slot: int?) {
    slot = nil;
}

fn set_seven(var slot: int?) {
    slot = 7;
}

fn print_slot(slot: int?) {
    if let value? = slot {
        println(value);
    } else {
        println(0);
    }
}

fn main() {
    var counts: [string: int] = ["a": 1];
    clear(counts["a"]);
    print_slot(counts["a"]);
    set_seven(counts["b"]);
    print_slot(counts["b"]);
}
