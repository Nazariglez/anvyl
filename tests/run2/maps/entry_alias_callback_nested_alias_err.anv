// @mode: run
// @frontend: new
// @expect: error
// @contains: cannot structurally mutate collection during active iteration or slice view

lazy var counts: [string: int] = ["a": 1];

fn nested_alias() {
    if var other? = counts["a"] {
        other = 99;
    }
}

fn main() {
    if var value? = counts["a"] {
        nested_alias();
        value += 1;
    }
}
