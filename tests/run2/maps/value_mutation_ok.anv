// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 33
// 187
// 16
// @match-end

fn sum_values(map: [string: int]) -> int {
    var sum = 0;
    for key, value in map {
        sum += value;
    }
    sum
}

fn bump(ref map: [string: int]) {
    for _, ref value in map {
        value += 10;
    }
}

fn main() {
    var map = ["a": 1, "b": 12];
    bump(map);
    println(sum_values(map));

    for _, ref value in map {
        value += 77;
    }
    println(sum_values(map));

    var nested = ["a": 1, "b": 2];
    for _, ref outer in nested {
        for _, inner in nested {
            outer += inner;
        }
    }
    println(sum_values(nested));

}
