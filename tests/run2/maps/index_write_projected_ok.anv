// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 2
// 4
// 3
// @match-end

fn print_slot(slot: int?) {
    if let value? = slot {
        println(value);
    } else {
        println(0);
    }
}

fn update(ref maps: [[string: int]]) {
    maps[0]["a"] = 4;
    maps[0]["b"] = 3;
}

fn main() {
    var maps: [[string: int]] = [["a": 1]];
    maps[0]["a"] = 2;
    print_slot(maps[0]["a"]);

    update(maps);
    print_slot(maps[0]["a"]);
    print_slot(maps[0]["b"]);
}
