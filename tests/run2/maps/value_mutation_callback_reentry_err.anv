// @mode: run
// @frontend: new
// @expect: error
// @skip: blocked by UnsupportedMutablePlaceProjection before runtime collection-loan reentry guard
// @contains: cannot structurally mutate collection during active iteration or slice view

fn apply(cb: fn()) {
    cb();
}

fn main() {
    var map = ["a": 1, "b": 2];
    let cb = || { map["z"] = 9; };
    for _, var value in map {
        apply(cb);
        value += 1;
    }
}
