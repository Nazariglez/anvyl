// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 3
// 3
// @match-end

fn main() {
    var groups: [string: [string: int]] = ["a": ["x": 1]];
    var inner? = groups["a"] else return;
    if var n? = inner["x"] {
        n += 2;
    }
    println(inner["x"] ?? 0);
    if let updated? = groups["a"] {
        println(updated["x"] ?? 0);
    }
}
