// @mode: run
// @frontend: new
// @expect: error
// @stderr-contains: cannot structurally mutate collection during active iteration or slice view

fn clear(var slot: int?) {
    slot = nil;
}

fn main() {
    var counts: [string: int] = ["a": 1, "b": 2];
    for key, value in counts {
        clear(counts[key]);
    }
}
