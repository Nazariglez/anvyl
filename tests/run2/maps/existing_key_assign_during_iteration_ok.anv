// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 20
// 30
// @match-end

fn sum_values(map: [string: int]) -> int {
    var sum = 0;
    for key, value in map {
        sum += value;
    }
    sum
}

fn main() {
    var readonly = ["a": 1, "b": 2];
    for key, value in readonly {
        readonly[key] = 10;
    }
    println(sum_values(readonly));

    var mutable = ["a": 1, "b": 2];
    for key, var value in mutable {
        value += 1;
        mutable[key] = 15;
    }
    println(sum_values(mutable));
}
