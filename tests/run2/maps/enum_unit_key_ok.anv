// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 1
// 10
// -1
// 10
// 2
// @match-end

enum Dir {
    Left,
    Right,
    Up,
}

fn print_slot(slot: int?) {
    if let value? = slot {
        println(value);
    } else {
        println(-1);
    }
}

fn main() {
    var by_dir: [Dir: int] = [Dir.Left: 1];
    print_slot(by_dir[Dir.Left]);

    by_dir[Dir.Left] = 10;
    by_dir[Dir.Right] = 2;
    print_slot(by_dir[Dir.Left]);
    print_slot(by_dir[Dir.Up]);

    for key, value in by_dir {
        println(value);
    }
}
