// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// a
// 3
// b
// 4
// @match-end

fn print_slot(slot: int?) {
    if let value? = slot {
        println(value);
    } else {
        println(0);
    }
}

fn main() {
    var counts: [string: int] = ["a": 1];
    let key = "a";
    counts[key] = 3;
    println(key);
    print_slot(counts[key]);

    let other = "b";
    counts[other] = 4;
    println(other);
    print_slot(counts[other]);
}
