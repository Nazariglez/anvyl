// @match-end

fn inc(var x: int) {
    x += 1;
}

fn main() {
    var xs: [int] = [1, 2, 3];
    var sum = 0;
    xs.for_each(|var x| {
        sum += x;
        x += 10;
    });
    println(sum);
    for x in xs {
        println(x);
    }

    xs.for_each(|var x| {
        var nested: [int] = [3, 4];
        nested.for_each(inc);
        x += 1;
    });
    for x in xs {
        println(x);
    }
}
