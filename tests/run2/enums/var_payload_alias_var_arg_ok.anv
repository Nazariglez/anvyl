// @mode: run
// @frontend: new
// @expect: success
// @skip: enum tuple payload mutable aliases await clean Rust enum payload match lowering
// @match: 2

enum Slot {
    Value(int),
}

fn bump(var value: int) {
    value += 1;
}

fn main() {
    var slot = Slot.Value(1);
    match var slot {
        Slot.Value(value) => bump(value),
    }
    match slot {
        Slot.Value(value) => println(value),
    }
}
