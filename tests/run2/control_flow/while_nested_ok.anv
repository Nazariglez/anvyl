// @mode: run
// @frontend: new
// @expect: success
// @match: 4

fn main() {
    var outer = 0;
    var count = 0;
    while outer < 2 {
        var inner = 0;
        while inner < 3 {
            inner = inner + 1;
            if inner == 2 { continue; }
            count = count + 1;
        }
        outer = outer + 1;
    }
    println(count);
}
