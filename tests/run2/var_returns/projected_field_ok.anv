// @mode: run
// @frontend: new
// @expect: success
// @skip: mutable projected place returns are not executable yet
// @match: 2

struct Box { value: int }

fn value(var box: Box) -> var int {
    box.value
}

fn main() {
    var box = Box { value: 1 };
    value(box) = 2;
    println(box.value);
}
