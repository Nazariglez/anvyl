// @mode: run
// @expect: success
// @skip: mixed heap-env and scoped lambda variants sharing one signature are still a backend representation gap
// @frontend: new

fn make(seed: int) -> fn() -> int {
    || seed
}

fn use_now() -> int {
    var count = 0;
    let f = || {
        count += 1;
        count
    };
    f()
}

fn main() {
    let f = make(3);
    println(f());
    println(use_now());
}
