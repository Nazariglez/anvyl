// @mode: run
// @expect: success
// @match-begin
// 3
// 10
// 1
// @match-end
// @frontend: new

fn make(seed: int) -> fn() -> int {
    || seed
}

fn zero() -> int {
    10
}

fn use_now() -> int {
    var count = 0;
    let f = || {
        count += 1;
        count
    };
    f()
}

fn main() {
    let f = make(3);
    let z = zero;
    println(f());
    println(z());
    println(use_now());
}
