// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 1
// 2
// @match-end

struct Point { x: int }

fn inc(var x: int) {
    x += 1;
}

fn read_x(var p: Point) -> int {
    p.x
}

fn make() -> fn() -> int {
    var p = Point { x: 0 };
    || {
        inc(p.x);
        read_x(p)
    }
}

fn main() {
    let f = make();
    println(f());
    println(f());
}
