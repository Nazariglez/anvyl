// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 42
// 42
// 42
// 42
// 5
// @match-end

const ANSWER: int = 41;

fn call(f: fn() -> int) -> int { f() }
fn make() -> fn() -> int { || { ANSWER + 1 } }

fn main() {
    let direct = || { ANSWER + 1 };
    println(direct());
    println(call(direct));

    let escaped = make();
    println(escaped());

    const N: int = 41;
    let local = || { N + 1 };
    println(local());

    const S: string = "hello";
    let postfix = || { S.len() };
    println(postfix());
}
