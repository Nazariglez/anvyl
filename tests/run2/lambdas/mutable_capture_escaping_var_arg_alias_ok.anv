// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 1
// 2
// @match-end

fn bump(var x: int) {
    x += 1;
}

fn make() -> fn() -> int {
    var count = 0;
    || {
        bump(count);
        count
    }
}

fn main() {
    let f = make();
    let g = f;
    println(f());
    println(g());
}
