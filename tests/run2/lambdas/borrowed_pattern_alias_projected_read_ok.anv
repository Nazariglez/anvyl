// @mode: run
// @frontend: new
// @expect: success
// @skip: ref pattern alias lambda capture is not executable yet
// @match: 7

struct Point { x: int, y: int }

fn read(ref point: Point) -> int {
    var Point { x } = point;
    let f = || x;
    f()
}

fn main() {
    var point = Point { x: 7, y: 0 };
    println(read(point));
}
