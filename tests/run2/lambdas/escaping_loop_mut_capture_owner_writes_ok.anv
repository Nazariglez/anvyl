fn make_callback() -> fn() -> int {
    var i = 0;
    while i < 1 {
        var count = 0;
        count += 10;
        let callback = || {
            count += 1;
            count
        };
        count += 1;
        return callback;
    }
    || 0
}

fn main() {
    let callback = make_callback();
    println(callback());
    println(callback());
}
