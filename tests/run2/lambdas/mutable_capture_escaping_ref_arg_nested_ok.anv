// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 1
// 2
// @match-end

fn bump(ref x: int) {
    x += 1;
}

fn make() -> fn() -> int {
    var count = 0;
    || {
        let inner = || { bump(count); };
        inner();
        count
    }
}

fn main() {
    let f = make();
    println(f());
    println(f());
}
