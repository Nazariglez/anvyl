// @mode: run
// @frontend: new
// @expect: success
// @skip: var self borrowed origins await mutable_place_projected_values
// @match: 1

struct Counter {
    value: int,
}

fn replace(var counter: Counter) {
    counter = Counter { value: 1 };
}

extend Counter {
    fn touch(var self) {
        let f = || {
            replace(self);
        };
        f();
    }
}

fn main() {
    var c = Counter { value: 0 };
    c.touch();
    println(c.value);
}
