// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 6
// 7
// @match-end

fn bump(var x: int) {
    x += 1;
}

fn make() -> fn() -> int {
    var count = 0;
    count = 5;
    || {
        bump(count);
        count
    }
}

fn main() {
    let f = make();
    println(f());
    println(f());
}
