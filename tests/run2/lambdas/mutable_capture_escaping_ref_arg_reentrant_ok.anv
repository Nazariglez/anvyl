// @mode: run
// @frontend: new
// @expect: success
// @match: 12

fn apply(ref x: int, cb: fn()) {
    x += 1;
    cb();
    x += 1;
}

fn make() -> fn() -> int {
    var count = 0;
    || {
        apply(count, || { count += 10; });
        count
    }
}

fn main() {
    let f = make();
    println(f());
}
