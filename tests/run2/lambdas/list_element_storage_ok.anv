// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 1
// 2
// 2
// 4
// 5
// 9
// @match-end

fn one() -> int { 1 }
fn nine() -> int { 9 }

fn main() {
    let readonly = 2;
    let text = "hi";
    var state = 3;
    var fs: [fn() -> int] = [
        one,
        || readonly,
        || text.len(),
        || { state = state + 1; state },
    ];

    let a = fs[0];
    let b = fs[1];
    let c = fs[2];
    let d = fs[3];
    println(a());
    println(b());
    println(c());
    println(d());
    println(d());

    fs.push(nine);
    let e = fs[4];
    println(e());
}
