// @mode: run
// @frontend: new
// @expect: success
// @skip: mutable pattern aliases of borrowed fields are not executable yet
// @match: 1

struct Point {
    x: int,
    y: int,
}

fn inc(var value: int) {
    value += 1;
}

fn touch(var point: Point) {
    var Point { x } = point;
    let f = || {
        inc(x);
    };
    f();
}

fn main() {
    var p = Point { x: 0, y: 0 };
    touch(p);
    println(p.x);
}
