// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 1
// 11
// @match-end

fn set_with_lambda(ref xs: [int]) {
    for ref x in xs {
        let f = || { x = x + 1; };
        if x == 10 {
            f();
        } else {
            f();
        }
    }
}

fn main() {
    var values: [int] = [0, 10];
    set_with_lambda(values);
    println(values[0]);
    println(values[1]);
}
