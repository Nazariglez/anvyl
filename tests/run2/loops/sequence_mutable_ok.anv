// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 2
// 3
// 4
// 8
// 8
// 10
// @match-end

fn bump_all(ref xs: [int]) {
    for ref x in xs {
        x += 1;
    }
}

fn set_twice(ref xs: [int]) {
    for ref x in xs {
        x = 7;
        x += 1;
    }
}

fn bump_slice(ref xs: slice[int]) {
    for ref x in xs {
        x += 1;
    }
}

fn main() {
    var list: [int] = [1, 2, 3];
    bump_all(list);
    println(list[0]);
    println(list[1]);
    println(list[2]);

    var second: [int] = [4, 5];
    set_twice(second);
    println(second[0]);
    println(second[1]);

    var slice_list: [int] = [9];
    bump_slice(slice_list);
    println(slice_list[0]);
}
