// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 1
// 11
// @match-end

fn apply(f: fn()) {
    f();
}

fn set_with_indirect_lambda(ref xs: [int]) {
    for ref x in xs {
        apply(|| { x = x + 1; });
    }
}

fn main() {
    var values: [int] = [0, 10];
    set_with_indirect_lambda(values);
    println(values[0]);
    println(values[1]);
}
