// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 4
// 5
// 8
// 2
// @match-end

struct Point {
    x: int = 1,
    y: int = 2,
}

struct Config {
    nums: [int] = [4, 5],
    pos: Point = Point { x: 8 },
}

fn main() {
    let config = Config {};
    println(config.nums[0]);
    println(config.nums[1]);
    println(config.pos.x);
    println(config.pos.y);
}
