// @mode: run
// @frontend: new
// @expect: success
// @skip: @as embed projection for var arguments is not executable yet
// @match: 2

struct Entity {
    x: int,
}

struct Enemy {
    @as embed entity: Entity,
}

fn bump(var entity: Entity) {
    entity.x += 1;
}

fn main() {
    var enemy = Enemy { entity: Entity { x: 1 } };
    bump(enemy);
    println(enemy.entity.x);
}
