// @mode: run
// @frontend: new
// @expect: success
// @skip: replacing collection fields through var parameters is not executable yet
// @match: 3

struct Box {
    xs: [int],
}

fn replace(var box: Box) {
    box.xs = [1, 2, 3];
}

fn main() {
    var box = Box { xs: [0] };
    replace(box);
    println(box.xs[2]);
}
