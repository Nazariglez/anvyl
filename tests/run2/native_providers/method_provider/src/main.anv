// @mode: run
// @expect: success
// @frontend: new
// @match: 25

import pkg:host.host { len2_of, fov_of, Vec2, Camera };

fn main() {
    let v = Vec2 { x: 3.0, y: 4.0 };
    let Vec2 { x, y } = v;
    let Vec2 { y: partial } = v;
    let Vec2 { sum, x: x_again } = v;
    assert(x == 3.0);
    assert(y == 4.0);
    assert(partial == 4.0);
    assert(sum == 7.0);
    assert(x_again == 3.0);
    assert(v.len2() == 25.0);
    assert(len2_of(v) == 25.0);

    let adjusted = Vec2 { x: 3.0, y: 4.0, sum: 10.0 };
    let Vec2 { x: adjusted_x, sum: adjusted_sum } = adjusted;
    assert(adjusted_x == 6.0);
    assert(adjusted_sum == 10.0);

    let default_camera = Camera {};
    let camera = Camera { fov: 70.0 };
    let Camera { fov } = camera;
    assert(fov_of(default_camera) == 45.0);
    assert(fov == 70.0);
    assert(fov_of(camera) == 70.0);

    println(25);
}
