// @mode: run
// @expect: success
// @frontend: new
// @match-begin
// 8
// 13
// 99
// 4
// @match-end

import pkg:host.host {
    host_direct_first, host_direct_make, host_direct_lookup, host_direct_map, host_slice_first,
};

fn main() {
    println(host_direct_first([8, 9]));
    let direct = host_direct_make();
    println(direct[1]);
    let scores = host_direct_map();
    println(host_direct_lookup(scores, "hp") ?? 0);
    let slice_values = [4, 5];
    println(host_slice_first(slice_values));
}
