// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 42
// 42
// 51
// 41
// 82
// @match-end

import pkg:host.host { retain, fire, close };

fn add_one(x: int) -> int {
    x + 1
}

fn fire_once(cb: escaping fn(int) -> int) {
    retain(cb);
    fire();
    close();
}

fn main() {
    fire_once(add_one);
    fire_once(|x: int| { x + 1 });

    let base = 10;
    fire_once(|x: int| { x + base });

    var total = 0;
    retain(|x: int| {
        total += x;
        total
    });
    fire();
    fire();
    close();
}
