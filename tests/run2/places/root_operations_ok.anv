// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 10
// 21
// 32
// 43
// @match-end

struct Counter {
    value: int,

    fn inc(var self) {
        self.value += 1;
    }
}

dataref Node {
    value: int,
}

lazy var global = Counter { value: 30 };

fn bump(var value: int) {
    value += 1;
}

fn set_counter(var counter: Counter, value: int) {
    counter.value = value;
    counter.inc();
}

fn main() {
    var local = Counter { value: 1 };
    local.value = 9;
    bump(local.value);
    println(local.value);

    set_counter(local, 20);
    println(local.value);

    global.value = 31;
    global.inc();
    println(global.value);

    var node = Node { value: 42 };
    bump(node.value);
    println(node.value);
}
