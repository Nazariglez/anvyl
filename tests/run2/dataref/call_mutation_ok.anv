// @mode: run
// @frontend: new
// @expect: success
// @match: 43

dataref Counter {
    value: int,
}

fn bump(var c: Counter) {
    c.value +=  1;
}

fn bump_twice(var c: Counter) {
    bump(c);
    bump(c);
}

fn main() {
    var c = Counter { value: 41 };
    bump_twice(c);
    println(c.value);
}
