// @mode: run
// @frontend: new
// @expect: success
// @match: hello juan from pepe

dataref Node {
    inner: Node?,
    value: string,

    fn do_it(self) {
        self.inner?.hello(self.value);
    }

    fn hello(self, from: string) {
        println("hello " + self.value + " from " + from);
    }
}

fn main() {
    let inner = Node { inner: nil, value: "juan" };
    let outer = Node { inner: inner, value: "pepe" };
    inner.do_it();
    outer.do_it();
}
