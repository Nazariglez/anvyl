// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// first true
// second false
// @match-end

struct Payload {
    flags: (bool, bool),
}

dataref Node {
    inner: Node?,
    payload: Payload,
}

fn main() {
    let payload = Payload { flags: (true, false) };
    let node = Node { inner: nil, payload: payload };
    if node.payload.flags.0 {
        println("first true");
    }
    if !node.payload.flags.1 {
        println("second false");
    }
}
