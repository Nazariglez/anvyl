// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 2
// 3
// @match-end

dataref Bag {
    values: [string: int],
}

fn print_slot(slot: int?) {
    if let value? = slot {
        println(value);
    } else {
        println(0);
    }
}

fn main() {
    var bag = Bag { values: ["a": 1] };
    bag.values["a"] = 2;
    bag.values["b"] = 3;
    print_slot(bag.values["a"]);
    print_slot(bag.values["b"]);
}
