// @mode: run
// @frontend: new
// @expect: success
// @match: 1

dataref Counter {
    value: int,
}

fn bump(var value: int) {
    value += 1;
}

fn touch(var c: Counter) {
    let cb = || { bump(c.value); };
    cb();
}

fn main() {
    var c = Counter { value: 0 };
    touch(c);
    println(c.value);
}
