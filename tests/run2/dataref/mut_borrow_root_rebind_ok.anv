// @mode: run
// @frontend: new
// @expect: success
// @match: 2

dataref Node {
    value: int,
}

fn replace(var target: Node, other: Node) {
    target = other;
}

fn main() {
    var a = Node { value: 1 };
    let b = Node { value: 2 };
    replace(a, b);
    println(a.value);
    assert(a == b);
}
