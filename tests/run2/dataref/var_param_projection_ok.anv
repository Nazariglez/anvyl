// @mode: run
// @frontend: new
// @expect: success
// @skip: dataref mutable-place projections await mutable_place_dataref_projections
// @match: 6

dataref Counter {
    value: int,
}

fn bump(var value: int) {
    value += 1;
}

fn main() {
    var c = Counter { value: 5 };
    bump(c.value);
    println(c.value);
}
