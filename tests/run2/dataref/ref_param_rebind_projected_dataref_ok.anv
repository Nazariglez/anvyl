// @mode: run
// @frontend: new
// @expect: success
// @match: 2

dataref Node {
    value: int,
}

dataref Holder {
    node: Node,
}

fn replace(ref target: Node, other: Node) {
    target = other;
}

fn main() {
    var holder = Holder { node: Node { value: 1 } };
    let other = Node { value: 2 };
    replace(holder.node, other);
    println(holder.node.value);
    assert(holder.node == other);
}
