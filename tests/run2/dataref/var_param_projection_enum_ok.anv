// @mode: run
// @frontend: new
// @expect: success
// @skip: enum payload dataref mutable-place projections are future work
// @match: 2

enum Slot {
    Value(int),
}

dataref Box {
    slot: Slot,
}

fn bump(var value: int) {
    value += 1;
}

fn main() {
    var box = Box { slot: Slot.Value(1) };
    match var box.slot {
        Slot.Value(value) => bump(value),
    }
    match box.slot {
        Slot.Value(value) => println(value),
    }
}
