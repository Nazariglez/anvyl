// @mode: run
// @frontend: new
// @expect: success
// @skip: dataref mutable-place projections await mutable_place_dataref_projections
// @match: 1

dataref Counter {
    value: int,
}

fn touch(var value: int) -> int {
    value = 2;
    1
}

fn main() {
    var counter = Counter { value: 0 };
    counter.value = touch(counter.value);
    println(counter.value);
}
