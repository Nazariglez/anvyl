// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 5
// 9
// @match-end

dataref Child {
    value: int,
}

dataref Parent {
    pair: (Child, int),
}

fn main() {
    let child = Child { value: 5 };
    let parent = Parent { pair: (child, 9) };
    println(parent.pair.0.value);
    println(parent.pair.1);
}
