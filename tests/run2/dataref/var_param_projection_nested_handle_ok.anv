// @mode: run
// @frontend: new
// @expect: success
// @skip: nested dataref-handle mutable-place projections are future work
// @match: 2

dataref Node {
    value: int,
}

struct Inline {
    node: Node,
}

dataref Holder {
    inner: Inline,
}

fn replace(var target: Node, other: Node) {
    target = other;
}

fn main() {
    var holder = Holder { inner: Inline { node: Node { value: 1 } } };
    replace(holder.inner.node, Node { value: 2 });
    println(holder.inner.node.value);
}
