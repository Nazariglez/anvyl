// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 12
// 100
// @match-end

dataref Counter {
    value: int,
}

fn apply(var x: int, cb: fn()) {
    x += 1;
    cb();
    x += 1;
}

fn main() {
    var c = Counter { value: 0 };
    var original = c;
    let cb = || {
        c = Counter { value: 100 };
        original.value += 10;
    };
    apply(c.value, cb);
    println(original.value);
    println(c.value);
}
