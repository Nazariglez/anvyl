// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 6
// hi!
// 12
// 7
// 9
// @match-end

struct Stats {
    bonus: int,
}

lazy let scale = 3;
lazy let suffix = "!";
lazy let stats = Stats { bonus: 5 };
lazy let numbers: [int] = [7];
lazy let scores: [string: int] = ["boss": 9];

fn main() {
    let a = || scale * 2;
    let b = || "hi" + suffix;
    let c = || stats.bonus + numbers[0];
    let d = || numbers[0];
    let e = || scores["boss"] ?? 0;

    println(a());
    println(b());
    println(c());
    println(d());
    println(e());
}
