// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// init
// 3
// @match-end

struct Box { value: int }

fn make_box() -> Box {
    println("init");
    Box { value: 1 }
}

lazy var state = make_box();

fn main() {
    state.value = 3;
    let local = state;
    println(local.value);
}
