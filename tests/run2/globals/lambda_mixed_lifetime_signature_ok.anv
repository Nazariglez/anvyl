// @mode: run
// @frontend: new
// @expect: success
// @match: 1

lazy let stored: fn() -> int = || 1;

fn apply(var x: int, cb: fn() -> int) {
    cb();
}

fn touch(var x: int) {
    let scoped = || {
        apply(x, || {
            x += 1;
            x
        });
    };
    scoped();
}

fn main() {
    var n = 0;
    touch(n);
    println(stored());
}
