// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// init
// 8
// @match-end

struct Box { value: int }

fn make_box() -> Box {
    println("init");
    Box { value: 3 }
}

fn bump(var value: int) {
    value += 5;
}

lazy var state = make_box();

fn main() {
    bump(state.value);
    println(state.value);
}
