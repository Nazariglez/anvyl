// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// 1
// 2
// @match-end

lazy var values: [string: int] = ["a": 1];
lazy var calls = 0;

fn key() -> string {
    calls += 1;
    "a"
}

fn bump(var value: int?) {
    value = 2;
}

fn main() {
    bump(values[key()]);
    println(calls);
    match values["a"] {
        value? => println(value),
        nil => println(0),
    };
}
