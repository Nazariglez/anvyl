// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// init
// 9
// @match-end

fn make_values() -> [int] {
    println("init");
    [1, 4]
}

fn bump(var value: int) {
    value += 5;
}

lazy var values = make_values();

fn main() {
    let index = 1;
    bump(values[index]);
    println(values[index]);
}
