// @mode: run
// @frontend: new
// @expect: success
// @match-begin
// red
// red
// blue
// green
// 2
// 9
// @match-end

lazy let names: [string] = ["red"];
lazy let scores: [string: int] = ["red": 2];

fn main() {
    let global_names = names;
    let global_scores = scores;
    var local_names = global_names;
    var local_scores = global_scores;
    local_names[0] = "blue";
    local_names.push("green");
    local_scores["red"] = 9;

    let reread_names = names;
    let reread_scores = scores;
    println(global_names[0]);
    println(reread_names[0]);
    println(local_names[0]);
    println(local_names[1]);
    match reread_scores["red"] {
        score? => println(score),
        nil => println(0),
    };
    match local_scores["red"] {
        score? => println(score),
        nil => println(0),
    };
}
