// @mode: check
// @expect: error
// @contains: cannot change list shape while iterating it

fn choose(flag: bool, a: [int], b: [int]) -> iter {
    if flag {
        let s = a;
        iter(s)
    } else {
        iter(b)
    }
}

fn main() {
    var xs: [int] = [1];
    var ys: [int] = [2];
    let flag = true;
    for x in choose(flag, xs, ys) {
        xs.push(x);
    }
}
