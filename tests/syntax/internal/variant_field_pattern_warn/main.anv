// @mode: check
// @expect: success
// @warn-contains: accessing internal field 'old_x' of type 'Event'

import lib { Event };

fn main() {
    let e = Event.Move { old_x: 1, x: 2 };
    match e {
        Event.Move { old_x, x } => {
            let _ = old_x;
            let _ = x;
        },
    }
}
