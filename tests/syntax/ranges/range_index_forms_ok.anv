// @mode: check
// @expect: success

fn take(xs: slice[int]) {}

fn copy_from_slice(xs: slice[int]) -> [int] {
    xs[1..3]
}

fn main() {
    let list: [int] = [1, 2, 3, 4];
    let array = [1, 2, 3, 4];

    let a: [int] = list[1..3];
    let b: [int] = list[1..=3];
    let c: [int] = list[2..];
    let d: [int] = list[..2];
    let e: [int] = list[..=2];

    let f: [int] = array[1..3];
    let g: [int] = copy_from_slice(list);
    let h: int = list[1..3][0];
    let pair: ([int], int) = (list[1..3], 0);

    take(list[1..3]);
    take(array[0..=2]);
    take(g);
    let _ignore = (a, b, c, d, e, f, h, pair);
}
