// @mode: check
// @expect: error
// @contains: ref arguments must not alias the same variable

struct Pair {
    left: int,
    right: int,
}

struct Holder {
    pair: Pair,

    fn pair(ref self) -> ref Pair {
        self.pair
    }
}

fn take_two(ref a: int, ref b: int) { }

fn main() {
    var holder = Holder { pair: Pair { left: 1, right: 2 } };
    take_two(holder.pair().left, holder.pair().right);
}
