// @mode: check
// @expect: success
// @frontend: new

contract Updatable {
    fn update(ref self);
}

struct Entity {
    hp: int,

    fn update(ref self) {
        self.hp += 1;
    }
}

struct Enemy {
    @as embed entity: Entity { hp as entity_hp },
}

fn test(n: int, enemy: Enemy, other: dyn Updatable) {
    let actor: dyn Updatable? = match n { 0 => enemy, _ => other };
}
