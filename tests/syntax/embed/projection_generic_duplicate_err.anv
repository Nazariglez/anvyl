// @mode: check
// @expect: error
// @frontend: new
// @contains: projection from 'Pair<int, int>' to 'int' is ambiguous

struct Pair<T, U> {
    @as embed left: T,
    @as embed right: U,
}

fn take_int(ref x: int) {}

fn test() {
    var pair = Pair<int, int> { left: 1, right: 2 };
    take_int(pair);
}
