// @mode: check
// @expect: error
// @frontend: new
// @contains: would require chaining

struct Entity {
    x: int,
}

struct Actor {
    @as embed entity: Entity,
}

struct Enemy {
    @as embed actor: Actor,
}

fn move_entity(var entity: as Entity) {}

fn test() {
    var enemy = Enemy { actor: Actor { entity: Entity { x: 1 } } };
    move_entity(enemy);
}
