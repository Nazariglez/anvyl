// @mode: check
// @expect: error
// @frontend: new
// @contains: mutating method requires mutable receiver 'damage'

struct Health {
    hp: int,

    fn damage(ref self, amount: int) {
        self.hp -= amount;
    }
}

struct Enemy {
    embed health: Health,
}

fn test(enemy: Enemy) {
    enemy.damage(3);
}
