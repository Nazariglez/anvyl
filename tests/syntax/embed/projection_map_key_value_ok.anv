// @mode: check
// @expect: success
// @frontend: new

struct Key { id: int }
struct Value { id: int }
struct KeyBox { @as embed key: Key }
struct ValueBox { @as embed value: Value }

fn test() {
    let key = KeyBox { key: Key { id: 1 } };
    let value = ValueBox { value: Value { id: 2 } };
    let map: [Key: Value] = [key: value];
}
