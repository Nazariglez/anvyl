// @mode: check
// @expect: error
// @contains: projection from 'Enemy' to 'Entity' is ambiguous
// @contains: @as embed paths: entity, actor.entity

struct Entity { x: int }
struct Actor { @as embed entity: Entity }

struct Enemy {
    @as embed entity: Entity,
    @as embed actor: Actor,
}

fn test(enemy: Enemy) {
    let entity: Entity = enemy;
}
