// @mode: check
// @expect: success
// @frontend: new

contract Updatable {
    fn update(ref self);
}

struct Entity {
    hp: int,

    fn update(ref self) {
        self.hp += 1;
    }
}

struct Enemy {
    @as embed entity: Entity { hp as entity_hp },
}

fn make_enemy() -> Enemy {
    Enemy { entity: Entity { hp: 1 } }
}

fn take_actor(actor: dyn Updatable?) {}

fn main() {
    take_actor(make_enemy());
}
