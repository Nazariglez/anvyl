// @mode: check
// @expect: success
// @warn-contains: use tick

contract Updatable {
    fn update(ref self);
}

struct Entity {
    hp: int,

    @deprecated("use tick")
    fn update(ref self) {
        self.hp += 1;
    }
}

struct Enemy {
    @as embed entity: Entity { hp as entity_hp },
}

fn take_actor(actor: dyn Updatable) {}

fn main() {
    let enemy = Enemy { entity: Entity { hp: 1 } };
    take_actor(enemy);
}
