// @mode: check
// @expect: success

struct Entity {
    x: int,
}

struct Enemy {
    @as embed entity: Entity,
}

struct EnemySlot {
    enemy: Enemy,
}

fn move_entity(ref entity: Entity, dx: int) {
    entity.x += dx;
}

fn test() {
    var slot = EnemySlot { enemy: Enemy { entity: Entity { x: 1 } } };
    move_entity(slot.enemy, 2);
}
