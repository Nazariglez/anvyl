// @mode: check
// @expect: error
// @contains: no `@as embed` projection path from 'Enemy' to 'Entity'
// @contains: use stored path entity explicitly

struct Entity { x: int }
struct Enemy { embed entity: Entity }

fn take(entity: Entity) {}

fn test() {
    let enemy = Enemy { entity: Entity { x: 1 } };
    take(enemy);
}
