// @mode: check
// @expect: error
// @frontend: new
// @contains: same variable

struct Entity {
    x: int,
}

struct Enemy {
    @as embed entity: Entity,
}

fn touch(var a: Entity, var b: Entity) {}

fn test() {
    var enemy = Enemy { entity: Entity { x: 1 } };
    touch(enemy, enemy.entity);
}
