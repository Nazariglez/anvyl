// @mode: check
// @expect: success

contract Updatable {
    fn update(ref self);
}

struct Entity {
    hp: int,

    fn update(ref self) {
        self.hp += 1;
    }
}

struct Enemy {
    @as embed entity: Entity { hp as entity_hp },
}

fn update_actor(ref actor: dyn Updatable) {
    actor.update();
}

fn main() {
    var enemy = Enemy { entity: Entity { hp: 1 } };
    update_actor(enemy);
}
