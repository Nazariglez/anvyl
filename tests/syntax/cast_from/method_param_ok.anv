// @mode: check
// @expect: success
// @frontend: new

struct Vec2 { x: float, y: float }

extend Vec2 {
    cast from(v: float) { Vec2 { x: v, y: v } }
}

struct Mover {
    fn move_by(self, offset: as Vec2) -> Vec2 { offset }
}

fn main() {
    let mover = Mover {};
    let _v = mover.move_by(1.0);
}
