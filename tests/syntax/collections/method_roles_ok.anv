// @mode: check
// @expect: success
// @frontend: new

fn main() {
    var xs: [int] = [1, -2, 3];
    xs.push(4);
    xs.for_each(|var x| {
        x += 1;
    });
    xs.retain(|x| x > 0);
    xs.remove_where(|x| x == 4);

    var counts: [string: int] = ["a": 1, "b": -1];
    counts.insert("c", 3);
    let removed = counts.remove("b");
    counts.retain(|key, value| value > 0);
    counts.remove_where(|key, value| key == "c");
}
