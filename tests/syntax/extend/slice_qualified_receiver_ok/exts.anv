// @helper

pub fn keep() {}

pub extend<T> slice[T] {
    fn first(self) -> T { self[0] }

    fn swap(ref self, a: int, b: int) {
        let tmp = self[a];
        self[a] = self[b];
        self[b] = tmp;
    }
}

pub extend<T> [T] {
    fn tag(self) -> string { "list" }
}

pub extend<T> slice[T] {
    fn tag(self) -> string { "slice" }
}
