// @mode: check
// @expect: success
// @frontend: new

contract Updatable {
    fn update(var self, dt: float);
}

struct Enemy {
    fn update(var self, dt: float) {}
}

fn tick(var actor: dyn Updatable, dt: float) {
    actor.update(dt);
}

fn main() {
    var actor: dyn Updatable = Enemy {};
    tick(actor, 1.0);
}
