// @mode: check
// @expect: error
// @frontend: new
// @contains: dynamic type-match arms cannot be mixed with ordinary pattern arms

contract Drawable { fn draw(self); }
struct Enemy { fn draw(self) {} }

fn main() {
    let actor: dyn Drawable = Enemy {};
    match actor {
        as Enemy(enemy) => enemy.draw(),
        _ => actor.draw(),
    };
}
