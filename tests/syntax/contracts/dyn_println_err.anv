// @mode: check
// @expect: error
// @frontend: new
// @contains: dynamic values cannot be implicitly formatted

contract Action {
    fn act(self);
}

struct Actor {
    fn act(self) {}
}

fn main() {
    let action: dyn Action = Actor {};

    // TODO: probably this can be allowed using the inner type we store on lowering...
    println(action);
}
