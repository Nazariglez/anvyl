// @mode: check
// @expect: success

contract Updatable {
    fn update(ref self, dt: float);
}

contract Drawable {
    fn draw(self);
}

contract Actor {
    Updatable;
    Drawable;
}

struct Enemy {
    hp: int,
}

extend Enemy {
    fn update(ref self, dt: float) {
        self.hp -= 1;
    }

    fn draw(self) {}
}

fn tick(ref actor: dyn Actor, dt: float) {
    actor.update(dt);
    actor.draw();
}

fn main() {
    var enemy = Enemy { hp: 10 };
    tick(enemy, 1.0);
}
