// @mode: check
// @expect: error
// @frontend: new
// @contains: duplicate dynamic match target

contract Drawable { fn draw(self); }
struct Enemy { fn draw(self) {} }

fn route<T>(actor: dyn Drawable) {
    match actor as? {
        Enemy(a) => {},
        T(b) => {},
        other => other.draw(),
    };
}

fn main() { route<Enemy>(Enemy {}); }
