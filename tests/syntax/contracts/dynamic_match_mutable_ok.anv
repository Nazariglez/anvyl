// @mode: check
// @expect: success
// @frontend: new

contract Updatable {
    fn update(var self);
}

struct Enemy {
    hp: int,
    fn update(var self) {}
}

struct Bullet {
    speed: int,
    fn update(var self) {}
}

fn main() {
    var actor: dyn Updatable = Enemy { hp: 1 };
    match var actor {
        as Enemy(enemy) => enemy.hp = 2,
        as Bullet(bullet) => bullet.speed = 3,
        else(other) => other.update(),
    };
}
