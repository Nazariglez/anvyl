// @mode: check
// @expect: success

struct Enemy {
    fn draw(self) {}
}

struct Label {
    fn draw(self) {}
}

fn use_actor(actor: dyn _) {
    actor.draw();
}

fn wrap<T>(actor: T) {
    use_actor(actor);
}

fn main() {
    wrap<Enemy>(Enemy {});
    wrap<Label>(Label {});
    wrap<Enemy>(Enemy {});
}
