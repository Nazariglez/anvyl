// @mode: check
// @expect: error
// @contains: cannot capture mutable pattern alias 'enemy' in an escaping lambda
// @frontend: new

contract Updatable {
    fn update(ref self);
}

struct Enemy {
    hp: int,

    fn update(ref self) {}
}

fn bad(ref actor: dyn Updatable) -> fn() {
    if ref enemy = actor as? Enemy {
        return || { enemy.hp = 1; };
    }
    || {}
}
