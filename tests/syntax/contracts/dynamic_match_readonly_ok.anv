// @mode: check
// @expect: success

contract Drawable {
    fn draw(self);
}

struct Enemy {
    fn draw(self) {}
    fn attack(self) {}
}

struct Bullet {
    fn draw(self) {}
    fn explode(self) {}
}

fn main() {
    let actor: dyn Drawable = Enemy {};
    match actor as? {
        Enemy(enemy) => enemy.attack(),
        Bullet(bullet) => bullet.explode(),
        other => other.draw(),
    };
}
