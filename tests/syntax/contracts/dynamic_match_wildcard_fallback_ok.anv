// @mode: check
// @expect: success

contract Updatable { fn update(ref self); }
struct Enemy { hp: int, fn update(ref self) {} }
struct Bullet { speed: int, fn update(ref self) {} }

fn main() {
    var actor: dyn Updatable = Enemy { hp: 1 };
    match ref actor as? {
        Enemy(_) => 1,
        _ => 2,
    };
}
