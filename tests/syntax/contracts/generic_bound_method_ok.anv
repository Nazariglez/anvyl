// @mode: check
// @expect: success

contract Named {
    fn name(self) -> string;
}

struct Person {
    fn name(self) -> string { "Ada" }
}

struct Box<T> {
    value: T,

    fn label<U: Named>(self, value: U) -> string {
        value.name()
    }
}

fn main() {
    let box = Box { value: 1 };
    let label = box.label(Person {});
}
