// @mode: check
// @expect: error
// @contains: dynamic weakening applies to values, not containers

contract A {
    fn a(self);
}

contract B {
    fn b(self);
}

struct AB {
    fn a(self) {}
    fn b(self) {}
}

fn use_array(values: [dyn A; 1]) {}

fn main() {
    let values: [dyn A + B; 1] = [AB {}];
    use_array(values);
}
