// @mode: check
// @expect: success
// @frontend: new

contract Updatable {
    fn update(ref self);
}

struct Enemy {
    hp: int,
    fn update(ref self) {}
}

struct Bullet {
    speed: int,
    fn update(ref self) {}
}

fn main() {
    var actor: dyn Updatable = Enemy { hp: 1 };
    match ref actor as? {
        Enemy(enemy) => enemy.hp = 2,
        Bullet(bullet) => bullet.speed = 3,
        other => other.update(),
    };
}
