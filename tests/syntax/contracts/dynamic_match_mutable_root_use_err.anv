// @mode: check
// @expect: error
// @frontend: new
// @contains: dynamic root cannot be used while a mutable downcast binding is live

contract Updatable { fn update(var self); }
struct Enemy { fn update(var self) {} }

fn main() {
    var actor: dyn Updatable = Enemy {};
    match var actor {
        as Enemy(enemy) => actor.update(),
        else(other) => other.update(),
    };
}
