// @mode: check
// @expect: error
// @frontend: new
// @contains: non-lvalue cannot be passed to var parameter

contract Updatable {
    fn update(var self, dt: float);
}

struct Enemy {
    fn update(var self, dt: float) {}
}

fn tick(var actor: dyn Updatable, dt: float) {}

fn main() {
    tick(Enemy {}, 1.0);
}
