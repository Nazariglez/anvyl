// @mode: check
// @expect: success
// @frontend: new

struct Enemy {
    fn draw(self) {}
    fn attack(self) {}
}

fn use_actor(actor: dyn _) {
    actor.draw();
    match actor {
        as Enemy(enemy) => enemy.attack(),
        else(other) => other.draw(),
    };
}

fn main() {
    use_actor(Enemy {});
}
