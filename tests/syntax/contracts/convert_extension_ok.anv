// @mode: check
// @expect: success
// @frontend: new

contract Updatable {
    fn update(var self, dt: float);
}

struct Enemy {
    hp: int,
}

extend Enemy {
    fn update(var self, dt: float) {
        self.hp = self.hp - 1;
    }
}

fn main() {
    var enemy = Enemy { hp: 10 };
    let actor: dyn Updatable = enemy;
}
