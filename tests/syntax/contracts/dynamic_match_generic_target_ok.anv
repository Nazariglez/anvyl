// @mode: check
// @expect: success
// @frontend: new

contract Drawable {
    fn draw(self);
}

struct Enemy {
    fn draw(self) {}
}

fn route<T>(actor: dyn Drawable) {
    match actor as? {
        T(value) => value.draw(),
        other => other.draw(),
    };
}

fn main() {
    route<Enemy>(Enemy {});
}
