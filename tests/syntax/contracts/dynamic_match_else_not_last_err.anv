// @mode: check
// @expect: error
// @frontend: new
// @contains: dynamic match else(...) arm must be last

contract Drawable { fn draw(self); }
struct Enemy { fn draw(self) {} }

fn main() {
    let actor: dyn Drawable = Enemy {};
    match actor {
        else(other) => other.draw(),
        as Enemy(enemy) => enemy.draw(),
    };
}
