// @mode: check
// @expect: error
// @frontend: new
// @contains: non-lvalue cannot be passed to ref parameter

contract Updatable {
    fn update(ref self, dt: float);
}

struct Enemy {
    fn update(ref self, dt: float) {}
}

fn tick(ref actor: dyn Updatable, dt: float) {}

fn main() {
    tick(Enemy {}, 1.0);
}
