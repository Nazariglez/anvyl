// @mode: check
// @expect: success
// @frontend: new

contract Updatable {
    fn update(var self, dt: float);
}

struct Enemy {
    hp: int,

    fn update(var self, dt: float) {
        self.hp -= 1;
    }
}

fn tick(var actor: dyn Updatable, dt: float) {
    actor.update(dt);
}

fn main() {
    var enemy = Enemy { hp: 10 };
    tick(enemy, 1.0);
}
