// @mode: check
// @expect: error
// @frontend: new
// @contains: dynamic root cannot be used while a mutable downcast binding is live

contract Drawable {
    fn draw(self);
}

struct Enemy {
    fn draw(self) {}
}

fn main() {
    var actor: dyn Drawable = Enemy {};
    if var enemy = actor as? Enemy {
        actor.draw();
    }
}
