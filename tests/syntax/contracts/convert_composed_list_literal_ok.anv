// @mode: check
// @expect: success

contract Drawable {
    fn draw(self);
}

contract Updatable {
    fn update(ref self);
}

struct Enemy {
    fn draw(self) {}
    fn update(ref self) {}
}

struct Button {
    fn draw(self) {}
    fn update(ref self) {}
}

fn main() {
    let items: [dyn Drawable + Updatable] = [Enemy {}, Button {}];
}
