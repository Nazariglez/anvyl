// @mode: check
// @frontend: new
// @expect: error
// @contains: invalid operand type
// @contains: cannot be applied to `string`

struct Pair<T> {
    a: T,
    b: T,

    fn diff(self) -> T {
        return self.a - self.b;
    }
}

fn main() {
    let p = Pair { a: "x", b: "y" };
    let d = p.diff();
}
