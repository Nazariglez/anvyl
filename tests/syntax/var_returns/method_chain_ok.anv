// @mode: check
// @expect: success
// @frontend: new

struct Button {
    width: int,
    height: int,
}

struct ButtonBuilder {
    width: int,
    height: int,

    fn width(var self, width: int) -> var Self {
        self.width = width;
        self
    }

    fn height(var self, height: int) -> var Self {
        self.height = height;
        self
    }

    fn build(self) -> Button {
        Button { width: self.width, height: self.height }
    }
}

fn main() {
    let button = ButtonBuilder { width: 0, height: 0 }
        .width(100)
        .height(40)
        .build();
}
