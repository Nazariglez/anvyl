fn top(var x: int) -> var int {
    x
}

struct Box {
    item: int,

    fn item(var self) -> var int {
        self.item
    }
}

fn takes(f: fn(var int) -> var int, var x: int) -> var int {
    f(x)
}

fn main() {
    let lambda = |var x: int| -> var int { x };
}
