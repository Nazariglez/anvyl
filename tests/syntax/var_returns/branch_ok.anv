// @mode: check
// @expect: success
// @frontend: new

fn pick(var x: int, cond: bool) -> var int {
    if cond { x } else { x }
}

fn pick_ternary(var x: int, cond: bool) -> var int {
    cond ? x : x
}

fn pick_match(var x: int, cond: bool) -> var int {
    match cond { true => x, false => x }
}

fn pick_return_branch(var x: int, cond: bool) -> var int {
    if cond { return x; } else { x }
}

fn pick_match_block(var x: int, cond: bool) -> var int {
    match cond { true => { return x; }, false => { x } }
}

fn main() {
    var n = 1;
    pick(n, true) = 2;
    pick_ternary(n, false) = 3;
    pick_match(n, true) = 4;
    pick_return_branch(n, true) = 5;
    pick_match_block(n, false) = 6;
}
