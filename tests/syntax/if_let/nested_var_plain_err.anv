// @mode: check
// @expect: error
// @contains: `var` is only allowed before the whole pattern
// @frontend: new

contract Drawable {
    fn draw(self);
}

struct Enemy {
    fn draw(self) {}
}

fn main() {
    let actor: dyn Drawable = Enemy {};
    if let var enemy = actor as? Enemy {
        enemy.draw();
    }
}
