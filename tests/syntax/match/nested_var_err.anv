// @mode: check
// @expect: error
// @contains: `var` is only allowed before the whole pattern
// @frontend: new
// @skip: generic println awaits to_string/format AIR lowering

fn main() {
    var opt: int? = 42;
    match opt {
        Option.Some(var value) => { println(value); },
        Option.None => {},
    }
}
