// @mode: check
// @expect: success
// @frontend: new

enum Event {
    Quit,
    Move { dx: int, dy: int },
    Damage(int),
}

fn main() {
    var event = Event.Move { dx: 1, dy: 2 };
    match ref event {
        Event.Quit => {},
        Event.Move { dx, dy } => {
            dx += 1;
            dy += 1;
        },
        Event.Damage(amount) => amount += 1,
    }
}
