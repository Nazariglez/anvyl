// @mode: check
// @expect: success
// @skip: generic println awaits to_string/format AIR lowering

fn bump(var x: int) {
    x += 1;
}

fn show(x: int) {
    println(x);
}

fn main() {
    let mutate: fn(var int) -> void = bump;
    let read: fn(int) -> void = show;
    let lambda_mutate: fn(var int) -> void = |var x: int| {
        x += 1;
    };
}
