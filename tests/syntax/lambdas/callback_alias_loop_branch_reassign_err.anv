// @mode: check
// @expect: error
// @contains: callback parameter 'f' is non-escaping by default, but it escapes here

fn bad(f: fn(), cond: bool, choose: bool) -> fn() {
    var g = || {};
    var h = || {};
    while cond {
        if choose {
            g = h;
        } else {
            g = || {};
        }
        h = f;
    }
    g
}
