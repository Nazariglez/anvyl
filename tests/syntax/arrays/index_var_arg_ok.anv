// @mode: check
// @expect: success
// @frontend: new

fn bump(var x: int) {
    x += 1;
}

fn bump_slice(var xs: slice[int], i: int) {
    bump(xs[i]);
}

fn main() {
    var fixed: [int; 3] = [0, 1, 2];
    var list: [int] = [0, 1, 2];
    let i = 1;

    bump(fixed[i]);
    bump(list[i]);
    bump_slice(list, i);
}
