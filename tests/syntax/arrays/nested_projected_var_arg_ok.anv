// @mode: check
// @expect: success
// @frontend: new

struct Point { x: int, y: int }
struct Entity { pos: Point }
struct World { entities: [Entity] }

fn bump(var x: int) {
    x += 1;
}

fn main() {
    var world = World {
        entities: [Entity { pos: Point { x: 0, y: 0 } }],
    };
    let i = 0;

    bump(world.entities[i].pos.x);
    world.entities[i].pos.y += 1;
}
