// @mode: check
// @expect: error
// @frontend: new
// @contains: Unknown method 'new'

extern type Point {
    x: float;
    y: float;
    fn new(x: float, y: float) -> Self;
}

extern fn make_point(x: float, y: float) -> Point;

fn main() {
    let p = make_point(1.0, 2.0);
    p.new(1.0, 2.0);
}
