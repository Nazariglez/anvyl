// @mode: check
// @expect: error
// @frontend: new
// @contains: instance method 'move_by' requires a value of type 'Point'

extern type Point {
    x: float;
    y: float;
    fn new(x: float, y: float) -> Self;
    fn move_by(var self, dx: float, dy: float);
}

fn main() {
    Point.move_by(1.0, 2.0);
}
