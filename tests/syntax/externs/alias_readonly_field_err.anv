// @mode: check
// @expect: error
// @contains: var pattern requires a mutable place
// @frontend: new
// @skip: FIXME: externs should not have let/var, fields mutability depend on binding not on definition

extern type Point {
    let x: float;
    var y: float;
}

fn main(var p: Point) {
    var Point { x } = p;
    x = 1.0;
}
