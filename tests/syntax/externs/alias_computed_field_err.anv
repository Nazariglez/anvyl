// @mode: check
// @expect: error
// @contains: var pattern requires a mutable place
// @frontend: new
// @skip: FIXME: computed values must behave as regular fields, so this must be fixed

extern type Point {
    computed var x: float;
}

fn main(var p: Point) {
    var Point { x } = p;
    x = 1.0;
}
