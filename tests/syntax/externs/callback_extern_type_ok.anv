// @mode: check
// @expect: success
// @frontend: new
// @skip: clean frontend lambda callback checking is deferred

extern type Counter {
    value: int;
    fn current(self) -> int;
}
extern fn run_with_counter(cb: fn(Counter) -> int) -> int;

fn main() {
    let result = run_with_counter(|c| {
        let v = c.value;
        c.current()
    });
}
