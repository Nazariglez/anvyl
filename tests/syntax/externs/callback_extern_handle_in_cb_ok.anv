// @mode: check
// @expect: success
// @frontend: new
// @skip: clean frontend lambda callback checking is deferred

extern type Counter {
    value: int;
    fn doubled(self) -> int;
}
extern fn with_counter(initial: int, cb: fn(Counter) -> int) -> int;

fn main() {
    let result = with_counter(10, |c| c.doubled() + c.value);
}
