// @mode: check
// @expect: success

struct Wrapper { code: int }
struct Source {}

enum State: int {
    Idle,
}

extend Wrapper {
    cast from(state: State) { Wrapper { code: state as int } }
}

extend State {
    cast from(source: Source) { State.Idle }
    cast from(raw: int) { State.Idle }
}

fn main() {
    let wrapped: Wrapper = State.Idle as Wrapper;
    let state: State = Source {} as State;
    let from_int: State = 0 as State;
}
