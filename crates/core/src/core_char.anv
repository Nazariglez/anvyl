import option { * };
import ext:core_char {
    char_codepoint,
    char_from_codepoint_ext,
    char_to_string,
};

pub fn char_from_codepoint(codepoint: int) -> char? { char_from_codepoint_ext(codepoint) }

pub extend char {
    fn codepoint(self) -> int { char_codepoint(self) }
    fn to_string(self) -> string { char_to_string(self) }

    fn is_ascii_digit(self) -> bool { self >= '0' && self <= '9' }
    fn is_ascii_lower(self) -> bool { self >= 'a' && self <= 'z' }
    fn is_ascii_upper(self) -> bool { self >= 'A' && self <= 'Z' }
    fn is_ascii_alpha(self) -> bool { self.is_ascii_lower() || self.is_ascii_upper() }
    fn is_ascii_alphanumeric(self) -> bool { self.is_ascii_alpha() || self.is_ascii_digit() }
    fn is_ascii_whitespace(self) -> bool {
        match self {
            ' ' => true,
            '\t' => true,
            '\n' => true,
            '\r' => true,
            _ => false,
        }
    }
}
