use serde::Serialize;

#[derive(Serialize)]
struct ProviderProbeEnvelope {
    schema: u32,
    package: anvyx_runtime::RawProviderPackage,
}

fn main() {
    println!("{}", serde_json::to_string(&ProviderProbeEnvelope {
        schema: 4,
        package: {{provider_crate}}::rust_providers(),
    }).unwrap());
}
