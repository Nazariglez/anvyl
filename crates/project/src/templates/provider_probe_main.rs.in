use serde::Serialize;

#[derive(Serialize)]
struct Output {
    descriptors: Vec<anvyx_runtime::ProviderDescriptor>,
    supports: Vec<anvyx_runtime::RustModuleSupport>,
}

fn main() {
    println!("{}", serde_json::to_string(&Output {
        descriptors: {{provider_crate}}::provider_descriptors(),
        supports: {{provider_crate}}::rust_module_supports(),
    }).unwrap());
}
