pub struct Range<T> {
    start: T,
    end: T,

    fn contains(self, value: T) -> bool {
        value >= self.start && value < self.end
    }
}

pub struct RangeInclusive<T> {
    start: T,
    end: T,

    fn contains(self, value: T) -> bool {
        value >= self.start && value <= self.end
    }
}

pub struct RangeFrom<T> {
    start: T,

    fn contains(self, value: T) -> bool {
        value >= self.start
    }
}

pub struct RangeTo<T> {
    end: T,

    fn contains(self, value: T) -> bool {
        value < self.end
    }
}

pub struct RangeToInclusive<T> {
    end: T,

    fn contains(self, value: T) -> bool {
        value <= self.end
    }
}
